{
  "name": "@blooger/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migration:generate": "node ./scripts/migration.mjs generate",
    "migration:create": "node ./scripts/migration.mjs create",
    "migration:run": "node ./scripts/migration.mjs run",
    "migration:revert": "node ./scripts/migration.mjs revert",
    "migration:show": "node ./scripts/migration.mjs show",
    "seed": "tsx src/database/seed.ts"
  },
  "dependencies": {
    "@blooger/shared": "*",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/typeorm": "^12.0.1",
    "argon2": "^0.45.1",
    "dotenv": "^17.4.2",
    "express-session": "^1.19.0",
    "markdown-it": "^15.0.1",
    "mysql2": "^3.24.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.17.7",
    "typeorm": "^1.1.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.0.0",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.2.2",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
